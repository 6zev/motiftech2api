# Copy to .env and edit. The server reads ./.env at startup when it exists.
# Real environment variables take precedence over anything in this file.
# Load a different file with DOTENV_PATH=/path/to/file.

# Gateway listen address
PORT=3000
HOST=0.0.0.0

# Upstream Motif chat service (do not change unless the site moves)
UPSTREAM_BASE=https://chat.motiftech.io
UPSTREAM_TIMEOUT_MS=120000

# Comma-separated bearer keys. Leave empty to run with no auth (localhost use).
GATEWAY_API_KEYS=

# Conversation store
CONVERSATION_TTL_HOURS=168
STORE_PATH=./.data/conversations.json

# Set to 1 for verbose logging. Never logs prompts or keys.
DEBUG=0

# --- Outbound proxy (upstream + --update) ---
# MOTIF_PROXY=socks5://127.0.0.1:1080
# MOTIF_PROXY=http://proxy:3128
# MOTIF_PROXY=none            # force direct

# --- Self-update ---
# UPDATE_REPO=6zev/motiftech2api
# UPDATE_ALLOW_PRERELEASE=
# GITHUB_TOKEN=
